---
import { site, nav, services } from '../data/site';
---

<footer class="border-t-[3px] border-ink bg-paper">
  <div class="container-x py-14 md:py-20">
    <div class="text-center">
      <p class="display text-4xl leading-none text-ink md:text-6xl">
        {site.brandShort}<span class="text-burgundy"> {site.brandTail}</span>
      </p>
      <p class="label mt-3 text-muted">Est. {site.established} · {site.address}</p>
    </div>

    <div class="section-label my-12">
      <span class="label shrink-0 text-muted">The Collection</span>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
      <div class="min-w-0">
        <p class="label text-muted">Browse</p>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0">
        <p class="label text-muted">Restoration</p>
        <ul class="mt-4 space-y-2.5">
          {
            services.slice(0, 5).map((service) => (
              <li>
                <a
                  href={`/services#${service.slug}`}
                  class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy"
                >
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0">
        <p class="label text-muted">Visit</p>
        <ul class="mt-4 space-y-2.5 text-sm text-ink/75">
          <li class="break-words">{site.address}</li>
          <li>{site.hours}</li>
          <li class="break-words">
            <a href={site.phoneHref} class="transition-colors duration-200 hover:text-burgundy">{site.phone}</a>
          </li>
          <li class="break-words">
            <a href={`mailto:${site.email}`} class="transition-colors duration-200 hover:text-burgundy">{site.email}</a>
          </li>
        </ul>
      </div>

      <div class="min-w-0">
        <p class="label text-muted">Legal</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/privacy" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Terms of Service</a></li>
          <li><a href="/cookies" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Cookie Policy</a></li>
          <li><a href="/disclaimer" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Vehicle Disclaimer</a></li>
          <li><a href="/accessibility" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Accessibility</a></li>
          <li><a href="/do-not-sell" class="text-sm text-ink/75 transition-colors duration-200 hover:text-burgundy">Do Not Sell My Info</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-chrome pt-6 text-xs text-muted md:flex-row md:items-center md:justify-between">
      <p>{`© ${new Date().getFullYear()} ${site.name}. All rights reserved.`}</p>
      <p>American classics · Sales &amp; restoration</p>
    </div>
  </div>
</footer>
