---
interface Props {
  src: string;
  alt: string;
  /** tailwind aspect class for the image box */
  ratio?: string;
  caption?: string;
  /** load immediately instead of lazily — use for the first image on a page */
  eager?: boolean;
  /** wrap in the bordered passe-partout frame (default) or sit flush inside a card */
  framed?: boolean;
  /** 'full' (1200x900) for wide slots, 'card' (640x480) for rows and cards */
  size?: 'full' | 'card';
  class?: string;
}

const {
  src,
  alt,
  ratio = 'aspect-[4/3]',
  caption,
  eager = false,
  framed = true,
  size = 'full',
  class: className = '',
} = Astro.props;

const file = size === 'card' ? src.replace(/\.webp$/i, '-card.webp') : src;
const w = size === 'card' ? 640 : 1200;
const h = size === 'card' ? 480 : 900;
const box = `relative overflow-hidden bg-paper ${ratio}`;
---

<figure class={className}>
  {
    framed ? (
      <div class="frame">
        <div class={box}>
          <img
            src={file}
            alt={alt}
            width={w}
            height={h}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    ) : (
      <div class={`${box} border border-chrome`}>
        <img
          src={file}
          alt={alt}
          width={w}
          height={h}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )
  }
  {caption && <figcaption class="label mt-3 text-center text-muted">{caption}</figcaption>}
</figure>
