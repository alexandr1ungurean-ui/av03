---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = 'h-5 w-5' } = Astro.props;

// 24x24 line icons matched to the service slugs in src/data/site.ts
const icons: Record<string, string> = {
  // Full Restoration — gear
  restoration:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.4M12 18.8v2.4M4 7.4l2.1 1.2M17.9 15.4l2.1 1.2M4 16.6l2.1-1.2M17.9 8.6l2.1-1.2"/>',
  // Engine & Drivetrain — piston and crank
  engine: '<rect x="8.5" y="3.5" width="7" height="6.5" rx="1"/><path d="M12 10v4.5"/><circle cx="12" cy="17.8" r="2.9"/>',
  // Paint & Bodywork — hammer
  bodywork:
    '<path d="M13.6 6.4l4.2-4.2 4 4-4.2 4.2z"/><path d="M14.8 8.6 5.4 18a2.2 2.2 0 0 0 3.1 3.1l9.4-9.4"/>',
  // Chrome & Trim — polish / shine
  chrome:
    '<path d="M10.5 3.5l1.6 4.7 4.7 1.6-4.7 1.6-1.6 4.7-1.6-4.7L4.2 9.8l4.7-1.6z"/><path d="M17.5 15.5l.8 2.3 2.3.8-2.3.8-.8 2.3-.8-2.3-2.3-.8 2.3-.8z"/>',
  // Upholstery & Interiors — seat
  interior:
    '<path d="M8.5 20.5v-5"/><path d="M8.5 15.5h5.5a2.5 2.5 0 0 1 2.5 2.5v2.5"/><path d="M9.5 15.5V5.6A1.6 1.6 0 0 1 11.1 4h.9a1.6 1.6 0 0 1 1.6 1.6v9.9"/>',
  // Appraisal & Consignment — document with seal
  appraisal:
    '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5V8h4"/><circle cx="12" cy="13.5" r="2.4"/><path d="M10.8 15.6 10.2 19.5l1.8-1.1 1.8 1.1-.6-3.9"/>',
};

const inner = icons[slug] ?? icons.restoration;
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
