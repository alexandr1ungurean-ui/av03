---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaSection from '../components/CtaSection.astro';
import { site, stats, testimonials } from '../data/site';

const values = [
  {
    title: 'Originality first',
    body: 'Matching numbers, correct date codes and period finishes. If a car cannot be made right, we say so before you buy it.',
  },
  {
    title: 'Documented work',
    body: 'Every restoration is photographed from teardown to final buff, and every invoice goes into a bound build file that stays with the car.',
  },
  {
    title: 'Driven, not stored',
    body: 'Each car is road-tested for at least fifty miles before it is offered. A classic that will not start is not a classic for sale.',
  },
  {
    title: 'One family, one bench',
    body: 'The same hands that restore a car prepare it for delivery. Nothing is subcontracted to a shop we would not visit ourselves.',
  },
];

const capabilities = [
  { label: 'Frame-off restoration', detail: 'Four to eighteen months, photographed at every stage' },
  { label: 'Engine & drivetrain', detail: 'Matching-numbers rebuilds, period carburetion and ignition' },
  { label: 'Metal & paint', detail: 'Lead work, panel beating, correct lacquer and base-coat finishes' },
  { label: 'Chrome & trim', detail: 'Show plating, stainless polishing, correct fasteners throughout' },
  { label: 'Interiors', detail: 'Correct hides, period patterns, original-style stitching' },
  { label: 'Storage & transport', detail: 'Climate-controlled bays and enclosed nationwide delivery' },
];
---

<BaseLayout
  title="About"
  description={`${site.name} has been buying, restoring and selling American classics in Detroit since ${site.established}. Three generations, one bench, documented work.`}
>
  <section class="container-x pb-12 pt-28 md:pt-36">
    <div class="section-label">
      <span class="label shrink-0 text-muted">Est. {site.established} · {site.address}</span>
    </div>
    <h1 data-reveal class="display mt-8 max-w-4xl text-5xl leading-[0.95] text-ink md:text-7xl">
      Three generations<br />of American iron
    </h1>
  </section>

  <section class="container-x pb-16">
    <div data-reveal class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
      <figure class="lg:col-span-7">
        <div class="frame">
          <div class="relative aspect-[16/11] overflow-hidden bg-paper">
            <img
              src="/hero.jpg"
              alt="The Golden Era Motors workshop floor in Detroit"
              width="1200"
              height="825"
              loading="eager"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
        <figcaption class="label mt-3 text-center text-muted">
          The shop floor · {site.address}
        </figcaption>
      </figure>

      <div class="lg:col-span-5">
        <div class="space-y-5 text-base leading-relaxed text-ink/80">
          <p>
            Golden Era Motors began in {site.established} as a two-bay garage on Michigan Avenue,
            fixing the cars that Detroit actually drove — Bel Airs, Impalas, Mustangs and the
            occasional very tired Cadillac. The work was straightforward: make it run right, make it
            look right, and write down what you did.
          </p>
          <p>
            Five decades later the address has not changed and neither has the method. We still buy
            cars one at a time, still restore them on the same bench, and still hand over a bound
            build file with every car that leaves the shop.
          </p>
          <p>
            What has changed is the market. American classics are collected worldwide now, so we
            photograph, document and ship accordingly — but we have never sold a car we would not
            happily drive home ourselves.
          </p>
        </div>
        <div class="mt-8">
          <Button href="/catalog">See the current floor</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x pb-16">
    <div class="grid grid-cols-2 border-y border-chrome md:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
            class:list={[
              'px-2 py-8 text-center md:px-6 md:py-10',
              i !== 0 && 'border-l border-chrome',
              i === 2 && 'border-l-0 md:border-l',
              i < 2 && 'border-b border-chrome md:border-b-0',
            ]}
          >
            <p class="display text-4xl text-burgundy md:text-5xl">{stat.value}</p>
            <p class="label mt-3 text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-x pb-16">
    <div class="section-label">
      <span class="label shrink-0 text-muted">How we work</span>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-x-14 gap-y-10 md:grid-cols-2">
      {
        values.map((value, i) => (
          <div data-reveal style={`--reveal-delay: ${(i % 2) * 60}ms`}>
            <h2 class="display text-2xl text-ink md:text-3xl">{value.title}</h2>
            <p class="mt-3 text-base leading-relaxed text-ink/75">{value.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-x pb-16">
    <div class="section-label">
      <span class="label shrink-0 text-muted">In the workshop</span>
    </div>
    <dl class="mt-10 grid grid-cols-1 border-t border-chrome lg:grid-cols-2">
      {
        capabilities.map((item, i) => (
          <div
            class:list={[
              'flex flex-col gap-1 border-b border-chrome py-5 lg:flex-row lg:items-baseline lg:gap-8',
              i % 2 === 0 && 'lg:pr-10',
              i % 2 === 1 && 'lg:border-l lg:border-chrome lg:pl-10',
            ]}
          >
            <dt class="display w-full shrink-0 text-xl text-ink lg:w-56">{item.label}</dt>
            <dd class="min-w-0 flex-1 text-sm leading-relaxed text-muted">{item.detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container-x pb-20 md:pb-24">
    <div class="section-label">
      <span class="label shrink-0 text-muted">Owners</span>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <blockquote data-reveal style={`--reveal-delay: ${i * 60}ms`} class="tag flex flex-col p-6">
            <p class="flex-1 text-base leading-relaxed text-ink/80">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-5 border-t border-chrome pt-4">
              <p class="display text-lg text-ink">{t.name}</p>
              <p class="label mt-1 text-muted">{t.role}</p>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="Come and see the shop"
    subtitle="The doors are open Monday to Saturday. Coffee is on, and you are welcome to look underneath anything on the floor."
  />
</BaseLayout>
