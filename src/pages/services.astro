---
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaSection from '../components/CtaSection.astro';
import { services } from '../data/site';

const triptych = [
  {
    src: '/scenes/service-restoration.webp',
    alt: 'Illustration of a classic car raised on a two-post lift with its wheels set aside',
    caption: 'Teardown & chassis',
  },
  {
    src: '/scenes/about-workshop.webp',
    alt: 'Illustration of a pegboard tool wall above a workbench with a vise',
    caption: 'The bench',
  },
  {
    src: '/scenes/service-bodywork.webp',
    alt: 'Illustration of a spray gun laying a fan of paint onto a car panel',
    caption: 'Paint & finish',
  },
];
---

<BaseLayout
  title="Restoration"
  description="Concours-level classic car restoration: full restorations, engine and drivetrain rebuilds, paint, chrome, interiors and appraisals."
>
  <section class="container-x pb-12 pt-28 md:pt-36">
    <div class="section-label">
      <span class="label shrink-0 text-muted">The Workshop</span>
    </div>
    <h1 data-reveal class="display mt-8 text-5xl text-ink md:text-7xl">Restoration &amp; Service</h1>
    <p data-reveal style="--reveal-delay: 60ms" class="mt-5 max-w-xl text-base leading-relaxed text-ink/75">
      Frame-off restorations, mechanical rebuilds and trim work — carried out by marque specialists
      and documented from the first photograph to the last invoice.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        triptych.map((plate, i) => (
          <Plate
            src={plate.src}
            alt={plate.alt}
            caption={plate.caption}
            eager={i === 0}
            class="w-full"
          />
        ))
      }
    </div>
  </section>

  <section class="container-x pb-20 md:pb-28">
    <div class="section-label">
      <span class="label shrink-0 text-muted">What we do</span>
    </div>

    <div class="mt-10 divide-y divide-chrome border-y border-chrome">
      {
        services.map((service, i) => (
          <article
            id={service.slug}
            data-reveal
            style={`--reveal-delay: ${(i % 3) * 60}ms`}
            class="grid grid-cols-1 gap-5 py-8 md:grid-cols-12 md:items-center md:gap-8 md:py-12"
          >
            <div class="md:col-span-3">
              <Plate src={service.image} alt={service.alt} size="card" class="w-full" />
            </div>

            <div class="md:col-span-6">
              <div class="flex items-center gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center border border-chrome text-burgundy">
                  <ServiceIcon slug={service.slug} class="h-5 w-5" />
                </span>
                <h2 class="display text-3xl text-ink md:text-4xl">{service.title}</h2>
              </div>
              <p class="mt-4 max-w-lg text-base leading-relaxed text-ink/75">{service.description}</p>
            </div>

            <div class="flex flex-col items-start gap-3 md:col-span-3 md:items-end">
              <p class="label text-burgundy">{service.price}</p>
              <a
                href="/contacts/"
                class="label group inline-flex items-center gap-2 text-ink transition-colors duration-200 hover:text-burgundy"
              >
                Book in
                <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="Start your restoration"
    subtitle="Send us photographs and the car's history — we will come back with an honest assessment and a written estimate."
  />
</BaseLayout>
